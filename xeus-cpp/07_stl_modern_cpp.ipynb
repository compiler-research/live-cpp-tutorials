    "using Number = variant<int, double, string>;\n",
    "\n",
    "vector<Number> numbers = {42, 3.14, string(\"forty-two\"), 100, 2.718};\n",
    "\n",
    "for (const auto& n : numbers) {\n",
    "    visit([](const auto& val) {\n",
    "        cout << val << \" (\" << typeid(val).name() << \")\" << endl;\n",
    "    }, n);\n",
   "execution_count": 9,
   "id": "variant-demo",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "42 (int)\n",
      "3.14 (double)\n",
      "forty-two (string)\n",
      "100 (int)\n",
      "2.718 (double)\n"
     ]
    }
   ],
   "source": [
    "// std::variant\n",
    "{\n",
    "    using Number = std::variant<int, double, std::string>;\n",
    "\n",
    "    std::vector<Number> my_numbers = {42, 3.14, std::string(\"forty-two\"), 100, 2.718};\n",
    "\n",
    "    for (const auto& n : my_numbers) {\n",
    "        std::visit([](const auto& val) {\n",
    "            std::cout << val << \" (\";\n",
    "            using T = std::decay_t<decltype(val)>;\n",
    "            \n",
    "            if constexpr (std::is_same_v<T, int>) {\n",
    "                std::cout << \"int\";\n",
    "            } else if constexpr (std::is_same_v<T, double>) {\n",
    "                std::cout << \"double\";\n",
    "            } else if constexpr (std::is_same_v<T, std::string>) {\n",
    "                std::cout << \"string\";\n",
    "            }\n",
    "            \n",
    "            std::cout << \")\" << std::endl;\n",
    "        }, n);\n",
    "    }\n",
    "}"
   ]
  }
